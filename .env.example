# ════════════════════════════════════════════════════════════════════════════
# TMA CONTRACT MANAGEMENT — Environment Variables Reference
# ════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
#   1. Copy this file to `.env.local` for local development.
#   2. NEVER commit `.env.local` or any real secrets to git.
#   3. Add production values in the Vercel dashboard → Settings → Environment Variables.
#
# VARIABLE NAMING CONVENTION:
#   VITE_*          Bundled into the client bundle — VISIBLE in the browser.
#                   Never put secrets here. Safe for public API endpoints,
#                   feature flags, and non-sensitive config.
#
#   (no prefix)     Server-only (available in Vercel Functions / Edge Middleware).
#                   Never exposed to the client. Safe for secrets, API keys,
#                   and database credentials.
#
# ════════════════════════════════════════════════════════════════════════════


# ── Application ──────────────────────────────────────────────────────────────

# Public base URL of the application (no trailing slash).
# Used for generating absolute URLs in emails, OG tags, etc.
# VITE_ prefix because it may be read by client-side utilities.
VITE_APP_URL=https://your-app.vercel.app

# Application environment: development | staging | production
VITE_APP_ENV=development


# ── Authentication — Supabase ─────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API
# Both are VITE_ (public) — the anon key is safe to expose client-side.
# It is scoped to your project's Row Level Security policies.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Service-role key — used ONLY by scripts/seed-supabase.mjs (never in the browser).
# Get from: Supabase Dashboard → Project Settings → API → service_role (secret)
# SERVER ONLY — never use VITE_ prefix; never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Legacy password gate (no longer used) ─────────────────────────────────────
# Set this in Vercel dashboard → Settings → Environment Variables.
# ⚠️  VITE_ prefix means this value IS visible in the compiled JS bundle.
#     It is intentional: the browser must compare against it with no backend.
#     This provides "keep out casual visitors" protection, not cryptographic security.
#     For high-security needs, replace with Clerk/Auth0 or Vercel Password Protection.
# Leave blank to disable the login gate entirely (local dev default).
VITE_APP_PASSWORD=

# The app currently uses client-side role management (RoleContext + localStorage).
# These variables are placeholders for when a real auth provider is added.
# Uncomment the block that matches your chosen provider.

# --- Option A: Clerk (https://clerk.com) ---
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...       # Safe to expose (VITE_ prefix)
# CLERK_SECRET_KEY=sk_live_...                 # SERVER ONLY — never expose

# --- Option B: NextAuth / Auth.js ---
# NEXTAUTH_URL=https://your-app.vercel.app     # SERVER ONLY
# NEXTAUTH_SECRET=<run: openssl rand -base64 32>  # SERVER ONLY — 32 random bytes

# --- Option C: Auth0 ---
# VITE_AUTH0_DOMAIN=your-tenant.auth0.com      # Safe to expose
# VITE_AUTH0_CLIENT_ID=...                     # Safe to expose
# AUTH0_CLIENT_SECRET=...                      # SERVER ONLY — never expose

# JWT secret used to sign session tokens in the custom middleware.
# Generate with: openssl rand -base64 64
# SERVER ONLY
JWT_SECRET=


# ── OpenAI API ────────────────────────────────────────────────────────────────
# WARNING: The current app stores the OpenAI key in localStorage (client-side).
# This exposes it to any JavaScript running on the page (XSS risk).
# RECOMMENDED: Move OpenAI calls to a Vercel Function so the key stays server-only.
#
# Current (insecure, client-side — user pastes it in Settings UI):
#   Key is stored in localStorage under "tma_openai_api_key"
#
# Future (secure, server-side):
#   Set this env var in Vercel dashboard and call your /api/query endpoint instead.
OPENAI_API_KEY=sk-...           # SERVER ONLY — never use VITE_ prefix for this


# ── Error Monitoring ──────────────────────────────────────────────────────────
# Sentry captures runtime exceptions and performance issues.
# Dashboard: https://sentry.io

# VITE_ prefix: used by the Sentry browser SDK to initialise in the client bundle.
# DSNs are not secret (they identify the project, not authenticate), so VITE_ is fine.
VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Auth token for uploading source maps to Sentry (build-time only).
# SERVER ONLY — only used in CI/CD, never shipped to the browser.
SENTRY_AUTH_TOKEN=


# ── Analytics (optional) ─────────────────────────────────────────────────────
# Example: Vercel Analytics is zero-config. Plausible / Posthog need a key.
# VITE_POSTHOG_KEY=phc_...        # Safe to expose (public write-only key)
# VITE_POSTHOG_HOST=https://app.posthog.com


# ── CSRF (if API routes are added) ───────────────────────────────────────────
# Secret used by lib/csrf.ts to sign and verify CSRF tokens.
# Generate with: openssl rand -hex 32
# SERVER ONLY
CSRF_SECRET=


# ── Excel / Data Persistence ──────────────────────────────────────────────────
# The dev server's /__api/save-table endpoint writes Excel files back to disk.
# No secrets needed for local dev. If you add a persistent storage backend
# (S3, Vercel Blob, Supabase Storage), add the credentials here.

# Example: Vercel Blob (https://vercel.com/docs/storage/vercel-blob)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...     # SERVER ONLY

# Example: AWS S3
# AWS_ACCESS_KEY_ID=                           # SERVER ONLY
# AWS_SECRET_ACCESS_KEY=                       # SERVER ONLY
# AWS_REGION=ap-southeast-1
# S3_BUCKET_NAME=tma-contract-data
